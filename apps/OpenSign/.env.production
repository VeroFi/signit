# Production Environment Variables for OpenSign Frontend

# DigitalOcean App Platform Configuration
# Note: These values will be overridden by app.yaml environment variables
# For App Platform deployment, PUBLIC_URL is set automatically via ${APP_URL}

# Frontend URLs
# For App Platform: This will be set to your app's URL (e.g., https://opensign-platform-xxxxx.ondigitalocean.app)
# For local development: http://localhost:3001
PUBLIC_URL=https://your-app-name.ondigitalocean.app

# Backend API URL
# Using relative path /api/app so App Platform routes to the backend service
# This works because App Platform's load balancer handles /api/* routing
REACT_APP_SERVERURL=/api/app

# Parse App Configuration
REACT_APP_APPID=opensign

# Build optimizations
GENERATE_SOURCEMAP=false
NODE_ENV=production